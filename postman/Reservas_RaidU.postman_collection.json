{
  "info": {
    "name": "RaidU - Reservas e integracion con viajes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "30 solicitudes en orden. Usar un viaje nuevo futuro publicado de 4 cupos y costo 6000, y cuatro tokens de cuentas diferentes. token_conductor debe ser el conductor; token_soporte debe pertenecer a Soporte. El recorrido crea reservas y conserva sus cancelaciones. python scripts/verificar_reservas_postman.py prepara un entorno temporal automaticamente."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "viaje_id",
      "value": ""
    },
    {
      "key": "token_conductor",
      "value": ""
    },
    {
      "key": "token_pasajero",
      "value": ""
    },
    {
      "key": "token_otro",
      "value": ""
    },
    {
      "key": "token_soporte",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Sin autenticacion",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/reservas/",
        "header": [],
        "description": "HTTP esperado 401. Ejecutar en orden sobre un viaje nuevo de 4 cupos y costo 6000.",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Conductor no reserva su viaje",
