            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "HTTP esperado 400. Ejecutar en orden sobre un viaje nuevo de 4 cupos y costo 6000.",
        "auth": {
          "type": "apikey",
          "apikey": [
            {
              "key": "key",
              "value": "Authorization",
              "type": "string"
            },
            {
              "key": "value",
              "value": "Token {{token_conductor}}",
              "type": "string"
            },
            {
              "key": "in",
              "value": "header",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"viaje\": \"{{viaje_id}}\", \"cupos\": 1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
