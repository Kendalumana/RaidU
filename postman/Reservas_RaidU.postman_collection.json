{
  "info": {
    "name": "RaidU - Reservas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Configurar base_url, los tres tokens y viaje_id de un viaje nuevo, futuro, publicado, con exactamente 4 cupos libres. Los dos pasajeros deben ser distintos del conductor y Soporte debe pertenecer al grupo Soporte. Ejecutar en orden. Se conservan las reservas canceladas: usar otro viaje al repetir. Los tokens se obtienen con POST /api/token/. Esta coleccion crea y cancela una reserva de prueba."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token_pasajero",
      "value": ""
    },
    {
      "key": "token_otro",
      "value": ""
    },
    {
      "key": "token_soporte",
      "value": ""
    },
    {
      "key": "viaje_id",
      "value": ""
    },
    {
      "key": "reserva_id",
      "value": ""
    },
    {
      "key": "pasajero_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Sin autenticacion",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/reservas/",
        "description": "HTTP esperado: 401. Ejecutar en el orden de la coleccion.",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Crear dos cupos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/reservas/",
        "description": "HTTP esperado: 201. Ejecutar en el orden de la coleccion.",
        "auth": {
          "type": "apikey",
          "apikey": [
            {
              "key": "key",
              "value": "Authorization",
              "type": "string"
            },
            {
              "key": "value",
              "value": "Token {{token_pasajero}}",
              "type": "string"
            },
            {
              "key": "in",
              "value": "header",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"viaje\": {{viaje_id}}, \"cupos\": 2}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set(\"reserva_id\", pm.response.json().id);",
              "  pm.collectionVariables.set(\"pasajero_id\", pm.response.json().pasajero);",
              "}"
            ]
          }
        }
      ]
    },
